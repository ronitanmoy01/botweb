# Copy to .env and adjust. Never commit the real .env file.
MOVIEHUB_ENVIRONMENT=development
# Required when MOVIEHUB_ENVIRONMENT=production. Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
MOVIEHUB_SECRET_KEY=
# SQLite fallback for local development:
MOVIEHUB_DATABASE_URL=sqlite+aiosqlite:///./moviehub.db
# PostgreSQL example (Neon / Supabase):
# MOVIEHUB_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
MOVIEHUB_SITE_NAME=MovieHub
MOVIEHUB_MAX_UPLOAD_BYTES=10485760
