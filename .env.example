# Copy to .env and adjust. Never commit the real .env file.
MOVIEHUB_ENVIRONMENT=development
# Required when MOVIEHUB_ENVIRONMENT=production. Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
MOVIEHUB_SECRET_KEY=
# SQLite fallback for local development:
MOVIEHUB_DATABASE_URL=sqlite+aiosqlite:///./moviehub.db
# PostgreSQL example (Neon / Supabase):
# MOVIEHUB_DATABASE_URL=postgresql+asyncpg://user:password@host/dbname
MOVIEHUB_SITE_NAME=MovieHub
MOVIEHUB_MAX_UPLOAD_BYTES=10485760

# ==========================================
# EMAIL (Gmail SMTP)
# ==========================================
# Requires a Google App Password (https://myaccount.google.com/apppasswords).
# Never use the normal Google account password, and never commit real credentials.
MOVIEHUB_MAIL_ENABLED=false
MOVIEHUB_MAIL_FROM_NAME=MovieHub
MOVIEHUB_MAIL_FROM_ADDRESS=your-account@gmail.com
MOVIEHUB_SMTP_HOST=smtp.gmail.com
MOVIEHUB_SMTP_PORT=587
MOVIEHUB_SMTP_USERNAME=your-account@gmail.com
# 16-character Google App Password (spaces are ignored by Google)
MOVIEHUB_SMTP_PASSWORD=your-16-character-app-password
# STARTTLS on port 587 (default). For port 465 set SMTP_USE_TLS=false and SMTP_USE_SSL=true.
MOVIEHUB_SMTP_USE_TLS=true
MOVIEHUB_SMTP_USE_SSL=false
MOVIEHUB_SMTP_TIMEOUT=20

# Public URL used to build absolute links in emails. Never derived from the request Host header.
MOVIEHUB_APP_BASE_URL=http://localhost:8000

# Token lifetimes
MOVIEHUB_PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
MOVIEHUB_EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Email delivery
MOVIEHUB_EMAIL_MAX_RETRIES=3
MOVIEHUB_EMAIL_WORKER_INTERVAL_SECONDS=10
